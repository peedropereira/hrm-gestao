# ============================================================
# HRM Gestão — variáveis de ambiente
# Copie este arquivo para ".env" (uso local) ou cadastre cada
# variável na Vercel: Project → Settings → Environment Variables.
# NUNCA coloque valores reais neste arquivo nem no GitHub.
# ============================================================

# Banco de dados (Neon). Na Vercel, ao conectar o Neon pelo Marketplace,
# estas duas são criadas automaticamente.
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Segredo que assina as sessões. Gere um valor aleatório longo:
#   https://generate-secret.vercel.app/32   (ou: npx auth secret)
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-caracteres-ou-mais"

# Fotos de evidência (Vercel Blob). Criado automaticamente ao conectar
# um Blob Store ao projeto na Vercel (aba Storage).
BLOB_READ_WRITE_TOKEN=""

# Usuário inicial, criado no primeiro deploy. A senha só é usada uma vez:
# depois de entrar, troque em Configurações e apague SEED_USER_PASSWORD da Vercel.
SEED_USER_LOGIN="pedro"
SEED_USER_NAME="Pedro"
SEED_USER_PASSWORD="uma-senha-com-pelo-menos-8-caracteres"

# Carregar dados de exemplo de caldeiraria no primeiro deploy (true/false).
SEED_DEMO="true"
